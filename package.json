    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@react-email/render": "^2.1.0",
    "@sanity/client": "^7.27.0",
    "@sanity/image-url": "^2.1.1",
    "@sanity/vision": "^5.31.2",
    "drizzle-orm": "^0.45.3",
    "next": "16.3.4",
    "next-sanity": "^13.3.4",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.30.0",
    "sanity": "^5.31.2",
    "styled-components": "^6.5.3",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.6.0"
