# Sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Editor token (sanity.io/manage → API → Tokens); decrements stock after orders
SANITY_API_WRITE_TOKEN=
SANITY_REVALIDATE_SECRET=

# Public origin used for VNPay return URLs and email links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Postgres (pnpm db:up starts this locally)
DATABASE_URL=postgres://shopco:shopco@localhost:5432/shopco

# VNPay (sandbox credentials from https://sandbox.vnpayment.vn/devreg/)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# MoMo (sandbox keys from https://business.momo.vn; IPN URL is <site>/api/webhooks/momo)
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn

# Auth.js — generate with `npx auth secret`
AUTH_SECRET=
# Google OAuth (optional; button hidden when unset). Redirect URI: <site>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Facebook Login (optional). Valid OAuth Redirect URI: <site>/api/auth/callback/facebook
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=

# Resend (emails are logged to the console when unset)
RESEND_API_KEY=
EMAIL_FROM=SHOP.CO <onboarding@resend.dev>
