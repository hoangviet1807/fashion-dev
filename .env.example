# Sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Editor token (sanity.io/manage → API → Tokens); decrements stock after orders
SANITY_API_WRITE_TOKEN=
SANITY_REVALIDATE_SECRET=

# Public origin used for VNPay return URLs and email links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Postgres (pnpm db:up starts this locally)
DATABASE_URL=postgres://shopco:shopco@localhost:5432/shopco
# Neon: DATABASE_URL = pooled URL (host contains "-pooler"); this one = direct URL, used by drizzle-kit
# DATABASE_URL_UNPOOLED=

# VNPay (sandbox credentials from https://sandbox.vnpayment.vn/devreg/)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# MoMo (sandbox keys from https://business.momo.vn; IPN URL is <site>/api/webhooks/momo)
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn

# payOS bank transfer / VietQR (keys from https://my.payos.vn → Kênh thanh toán;
# webhook URL is <site>/api/webhooks/payos)
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# Auth.js — generate with `npx auth secret`
AUTH_SECRET=
# Google OAuth (optional; button hidden when unset). Redirect URI: <site>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Facebook Login (optional). Valid OAuth Redirect URI: <site>/api/auth/callback/facebook
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=

# Resend (emails are logged to the console when unset)
RESEND_API_KEY=
EMAIL_FROM=SHOP.CO <onboarding@resend.dev>

# Admin (grant access with `pnpm user:role EMAIL admin|staff`)
# Low-stock alert recipients, comma-separated; defaults to every admin account
ADMIN_ALERT_EMAILS=
# Variants at or below this count are "low stock" (admin, Studio, alert emails)
NEXT_PUBLIC_LOW_STOCK_THRESHOLD=5

# Sentry error tracking (disabled when the DSN is empty). DSN: sentry.io → Project settings → Client keys
NEXT_PUBLIC_SENTRY_DSN=
# Defaults to the Vercel environment / NODE_ENV
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# Share of requests traced for performance (0–1)
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
# Build-time source map upload (CI / deploy only; skipped when the token is empty)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Analytics: Vercel Analytics turns on automatically on Vercel (enable it in the project dashboard);
# GA4 loads only when a measurement ID is set
NEXT_PUBLIC_GA_ID=
